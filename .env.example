# ===== OKX Fast API 接入 Demo 配置 =====
# 复制本文件为 .env 后填写。.env 含密钥，切勿提交到 git。

# 从 BD 申请 OAuth Broker（需开通 Fast API 权限 + IP 白名单）后，邮件中获取
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# 回调地址：必须在 OKX 侧注册的白名单内。本 demo 默认用首页地址。
REDIRECT_URI=http://localhost:8000/

# Fast API 固定为 fast_api
SCOPE=fast_api

# 站点：全球 https://www.okx.com ；土耳其 https://tr.okx.com ；EEA https://eea.okx.com
# （回跳 domain 也只接受这三个之一，见 app.py 的 ALLOWED_DOMAINS）
OKX_BASE_URL=https://www.okx.com

# 1 = 模拟盘（默认，安全）；0 = 实盘
SIMULATED=1

# MOCK=1：后端不发真实 HTTP，返回预置假响应，无需 client_id/secret 也能本地跑通整条流程（见 TESTING.md）。
# 正式联调请删除本项或设为 0。
MOCK=0

# 创建 API Key 用的 passphrase：8-32 位，至少含 1 个大写、1 个小写、1 个数字、1 个特殊字符。
# 请自行设置一个强口令，不要使用任何示例值或弱口令。
APIKEY_PASSPHRASE=<SET_A_STRONG_PASSPHRASE>

# 创建出的 Key 的备注与权限。默认 read_only 最安全；需要下单再改 trade。
APIKEY_LABEL=demo
APIKEY_PERM=read_only
