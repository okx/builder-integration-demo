# ===== Self account + local OpenAPI script demo =====
# Copy this file to .env. Real .env contains secrets and must not be committed.

# demo = OKX demo trading API key, sends x-simulated-trading: 1.
# live = OKX live trading API key, does not send x-simulated-trading.
OKX_PROFILE=demo

# OKX site: global, eea, us, or tr.
OKX_SITE=global

# Optional custom API base URL. Leave empty for the OKX_SITE mapping.
# OKX_API_BASE_URL=https://www.okx.com

OKX_DEMO_API_KEY=<YOUR_OKX_DEMO_API_KEY>
OKX_DEMO_SECRET_KEY=<YOUR_OKX_DEMO_SECRET_KEY>
OKX_DEMO_PASSPHRASE=<YOUR_OKX_DEMO_PASSPHRASE>

OKX_LIVE_API_KEY=<YOUR_OKX_LIVE_API_KEY>
OKX_LIVE_SECRET_KEY=<YOUR_OKX_LIVE_SECRET_KEY>
OKX_LIVE_PASSPHRASE=<YOUR_OKX_LIVE_PASSPHRASE>
