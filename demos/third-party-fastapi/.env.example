# ===== OKX Fast API demo configuration =====
# Copy this file to .env and fill in real values. .env contains secrets; never commit it.

# Received from BD after OAuth Broker approval with Fast API permission and IP allowlist.
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Callback URL. It must be registered in the OKX redirect whitelist.
REDIRECT_URI=http://localhost:8000/

# Demo target site. This demo is written and tested with OKX Global.
# For other OKX sites, check endpoint availability in the OpenAPI Markdown docs first.
OKX_BASE_URL=https://www.okx.com

# 1 = simulated trading; 0 = live trading.
SIMULATED=1

# Passphrase used when creating the Fast API Key.
# Must be 8-32 chars and include uppercase, lowercase, number, and special char.
APIKEY_PASSPHRASE=<SET_A_STRONG_PASSPHRASE>

# Created key permission. read_only is the safest default; use trade only for order tests.
APIKEY_PERM=read_only

# AI Builder Code assigned by OKX, 1-16 alphanumeric characters.
# Order writes must send it as OKX request field tag for AI Builder attribution.
# It can be blank for auth/balance-only checks, but is required for order tests.
AI_BUILDER_CODE=
